# ============================================================================
# BlogBoard AI Blog Generator - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual API keys
# Note: Most values should NOT be wrapped in quotes (see comments below)
# ============================================================================

# LLM Settings
# Get your API key from: https://console.groq.com/ or https://platform.openai.com/
llm__api_key=""  # No quotes needed


# Cloudflare R2 Settings (Optional - for R2 storage instead of Supabase)
# Get credentials from: https://dash.cloudflare.com/
r2__account_id=""  # No quotes needed
r2__access_key_id=""  # No quotes needed
r2__secret_access_key=""  # No quotes needed
r2__bucket_name=""  # No quotes needed


# Supabase Settings
# Get credentials from: https://supabase.com/dashboard
supabase__url=""  # No quotes needed (e.g., https://yourproject.supabase.co)
supabase__key=""  # No quotes needed
supabase__bucket_name="blogboard"  # No quotes needed


# Content API Settings
# Tavily: https://tavily.com/
content__tavily_api_key=""  # No quotes needed

# Guardian API: https://open-platform.theguardian.com/
content__guardian_api_key=""  # No quotes needed

# Unsplash: https://unsplash.com/developers
content__unsplash_api_key=""  # No quotes needed


# Opik Settings (Optional - for LLM observability)
# Get API key from: https://www.comet.com/site/products/opik/
OPIK_API_KEY=""  # No quotes needed
OPIK_PROJECT_NAME="blogboard"  # No quotes needed


# Sentry Settings (Optional - for error tracking)
# Get DSN from: https://sentry.io/
SENTRY_DSN=""  # No quotes needed
